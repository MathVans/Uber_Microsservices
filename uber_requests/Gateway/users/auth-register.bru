meta {
  name: auth/register
  type: http
  seq: 2
}

post {
  url: {{link}}{{prefix}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  User-Agent: insomnia/11.6.1
}

body:json {
  {
      "name": "passenger",
      "email": "passenger@example.com",
      "password": "Secure123@",
      "role": "driver"
  }
}

vars:pre-request {
  prefix: api/v1
}

settings {
  encodeUrl: true
  timeout: 0
}
